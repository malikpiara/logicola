{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // LogiCola on Cloudflare Workers since 2026-09-24 (moved from Vercel,
  // whose Hobby limits the site had outgrown). The site is the Next
  // static export in out/ (next.config.mjs `output: 'export'`), served
  // as static assets: those requests never run the Worker and are not
  // metered. worker/index.ts runs only for /api/* — the newsletter.
  "name": "logicola",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Unknown paths get the export's 404.html with a 404 status, without
    // invoking the Worker (bots probing for backups included).
    "not_found_handling": "404-page",
    // /blog serves blog.html and /blog/ redirects to /blog, matching
    // Next's default (trailingSlash: false) on Vercel.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // A route, not a custom domain (Malik, 2026-09-24). The Worker answers
  // logicola.org/* in front of the zone's own proxied DNS record, which
  // is an originless placeholder (A 192.0.2.0) since Vercel was retired
  // the same day: requests never reach it. A custom domain was tried and
  // refused — Cloudflare won't attach one while the hostname has a record
  // it doesn't manage (code 100117), and deleting that record first opens
  // a gap resolvers can cache for up to ~30 minutes. The route needs the
  // proxied record to exist; don't delete it. There is no Vercel fallback
  // any more — roll back with a Worker version (docs/deployment.md).
  // www.logicola.org is a zone Redirect Rule (www → apex, 301), not a
  // route here: a route would serve the site on www instead.
  "routes": [{ "pattern": "logicola.org/*", "zone_name": "logicola.org" }],
  // Wrangler turns both off once a route exists unless they are stated.
  // Kept on: the workers.dev URL and per-version preview URLs are how a
  // branch gets looked at before it reaches main, as Vercel previews
  // were. public/_headers marks every workers.dev host noindex.
  "workers_dev": true,
  "preview_urls": true,
  // Workers Builds runs `npx wrangler preview` for every non-main branch,
  // and it refuses to run without this block (the first build failed on
  // exactly that, 2026-09-24). Empty on purpose: a Preview inherits
  // nothing from production — no route, no secrets — so its newsletter
  // answers 503 and branch testing can't subscribe anyone.
  "previews": {},
  // Workers Logs: where newsletter failures (console.error) show up.
  "observability": {
    "enabled": true,
  },
}
