{
  "name": "logicola",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/generate-offline-manifest.mjs",
    "start": "next start",
    "lint": "eslint .",
    "content:build": "content-collections build",
    "eslint": "eslint . --ext .ts,.tsx && tsc --noEmit",
    "lint-all": "pnpm content:build && eslint . --ext .ts,.tsx && tsc --noEmit && prettier --check --ignore-path .gitignore .",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "offline:manifest": "node scripts/generate-offline-manifest.mjs",
    "brand:assets": "node --no-warnings scripts/brand-assets.mjs",
    "visual:baseline": "node scripts/visual-snapshots.mjs baseline",
    "visual:capture": "node scripts/visual-snapshots.mjs current",
    "visual:compare": "node scripts/compare-visual-snapshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.400.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.2",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.5.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "image-size": "^2.0.2",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "remark-smartypants": "^3.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    },
    "patchedDependencies": {
      "vaul@1.1.2": "patches/vaul@1.1.2.patch"
    }
  }
}
