    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.1",
    "@types/katex": "^0.16.7",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.379.0",
    "next": "14.2.10",
