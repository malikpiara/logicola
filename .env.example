# Read by `next build` / `next dev` and inlined into the client bundle.
# In production they are Workers Builds build variables
# (docs/deployment.md). Unset, analytics stay off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Worker-only (worker/index.ts). Loops.so → Settings → API. The
# newsletter endpoint returns 503 when unset. In production this is a
# Worker secret: `pnpm exec wrangler secret put LOOPS_API_KEY`. Locally,
# `pnpm start` (wrangler dev) reads it from .env.local — so signups
# there are real; a .dev.vars file without it turns that off.
LOOPS_API_KEY=
# Optional: Loops → Audience → a mailing list's ID, if subscribers
# should land in a specific list rather than just subscribed=true.
# Also a Worker secret in production.
LOOPS_MAILING_LIST_ID=
